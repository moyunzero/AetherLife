{
  "name": "aetherlife",
  "private": true,
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "turbo run build",
    "test": "turbo run test --continue",
    "dev": "turbo run dev --filter=@aetherlife/web --filter=@aetherlife/game-server",
    "dev:stack": "concurrently -k -n web+gs,ai,worker -c cyan,magenta,yellow \"pnpm dev\" \"pnpm dev:ai\" \"pnpm dev:worker\"",
    "dev:stack:mock": "concurrently -k -n web+gs,ai,worker -c cyan,magenta,yellow \"pnpm dev\" \"pnpm dev:ai\" \"LLM_MOCK=1 pnpm dev:worker\"",
    "dev:ai": "cd apps/ai-gateway && uv run uvicorn app.main:app --reload --port 8000",
    "dev:worker": "cd workers/agent-worker && uv run python -m src.main",
    "docker:ai": "docker compose -f infra/docker-compose.yml up -d ai-gateway",
    "verify:cloud": "node scripts/verify-cloud.mjs",
    "verify:llm-models": "node scripts/verify-llm-models.mjs",
    "benchmark:llm-e2e": "node scripts/benchmark-llm-e2e-latency.mjs",
    "benchmark:speak-browser": "node scripts/benchmark-speak-browser.mjs",
    "benchmark:social-providers": "cd workers/agent-worker && uv run python ../../scripts/benchmark-social-providers.py",
    "verify:phase2": "node scripts/verify-phase2.mjs",
    "verify:phase3": "node scripts/verify-phase3.mjs",
    "verify:phase4": "node scripts/verify-phase4.mjs",
    "verify:phase5": "node scripts/verify-phase5.mjs",
    "verify:phase6": "node scripts/verify-phase6.mjs",
    "verify:phase6:move-only": "SKIP_SPEAK_VERIFY=1 node scripts/verify-phase6.mjs",
    "verify:phase7": "node scripts/verify-phase7.mjs",
    "verify:phase8": "node scripts/verify-phase8.mjs",
    "verify:phase8:move-only": "SKIP_SPEAK_VERIFY=1 node scripts/verify-phase8.mjs",
    "verify:phase8:soak": "SOAK=1 node scripts/verify-phase8.mjs",
    "verify:phase10": "node scripts/verify-phase10.mjs",
    "verify:phase10:move-only": "node scripts/verify-phase10.mjs",
    "verify:phase11": "node scripts/verify-phase11.mjs",
    "verify:phase12": "node scripts/verify-phase12.mjs",
    "art:import": "node scripts/import-phase13.2-farm-art.mjs --all",
    "art:import:farm": "node scripts/import-phase13.2-farm-art.mjs --all",
    "art:import:roguelike": "node scripts/import-phase13-art.mjs --all",
    "art:import:tiles": "node scripts/import-phase13.2-farm-art.mjs --tiles-only",
    "art:import:lpc": "node scripts/import-phase13-art.mjs --characters --npcs",
    "assets:sync:lpc-npcs": "node scripts/sync-npc-lpc-assets.mjs",
    "assets:sync:lpc-npc1": "node scripts/sync-npc-lpc-assets.mjs",
    "art:import:character": "node scripts/import-character-art.mjs",
    "art:placeholder": "node scripts/generate-phase13-atlases.mjs",
    "art:agnes:preview": "node scripts/agnes-ui-assets.mjs --preview",
    "art:agnes:batch": "node scripts/agnes-ui-assets.mjs --batch",
    "art:agnes:list": "node scripts/agnes-ui-assets.mjs --list",
    "art:agnes:roads": "node scripts/agnes-road-assets.mjs",
    "art:agnes:roads:supplement": "node scripts/agnes-road-assets.mjs --supplement",
    "bake:one-city": "node scripts/bake-beginning-fields.mjs",
    "bake:village-plaza": "node scripts/bake-village-plaza.mjs",
    "verify:phase13": "node scripts/verify-phase13.mjs",
    "verify:phase19": "node scripts/verify-phase19.mjs",
    "verify:phase20": "node scripts/verify-phase20.mjs",
    "verify:overlay-streaming": "node scripts/verify-overlay-streaming.mjs",
    "playtest:speak-sla": "node scripts/playtest-speak-sla.mjs",
    "uat:phase20:playwright": "node scripts/playtest-speak-sla.mjs",
    "verify:phase14": "node scripts/verify-phase14.mjs",
    "verify:phase16": "node scripts/verify-phase16.mjs",
    "e2e:phase16": "node scripts/run-phase16-e2e.mjs",
    "e2e:phase16:start": "node scripts/run-phase16-e2e.mjs --start",
    "uat:phase16:playwright": "node scripts/run-phase16-e2e.mjs",
    "verify:phase15": "pnpm verify:phase21",
    "verify:phase21": "node scripts/verify-phase21.mjs",
    "verify:phase22": "node scripts/verify-phase22.mjs",
    "verify:phase25": "node scripts/verify-phase25.mjs",
    "verify:phase26": "node scripts/verify-phase26.mjs",
    "uat:phase26": "node scripts/uat-phase26-playwright.mjs",
    "uat:phase25:core-ui": "node scripts/uat-phase25-core-ui.mjs",
    "uat:phase25:speak-defer": "node scripts/uat-phase25-speak-defer.mjs",
    "uat:phase25:traveler": "node scripts/uat-phase25-traveler.mjs",
    "uat:phase25:canon-speak": "node scripts/uat-phase25-canon-speak.mjs",
    "uat:phase25:golden-flows": "node scripts/uat-phase25-golden-flows.mjs",
    "council:export-personas": "pnpm exec tsx scripts/export-council-persona-mirrors.ts",
    "council:export-personas-compact": "pnpm council:export-personas",
    "council:audit-personas": "pnpm exec tsx scripts/audit-council-persona-sync.ts",
    "uat:phase21:playwright": "node scripts/uat-phase21-playwright.mjs",
    "uat:phase22:playwright": "node scripts/uat-phase22-playwright.mjs",
    "uat:phase15:playwright": "node scripts/uat-phase15-playwright.mjs",
    "uat:phase13:playwright": "node scripts/uat-phase13-playwright.mjs",
    "uat:phase12.1:playwright": "node scripts/uat-phase12.1-playwright.mjs",
    "e2e:full-run": "node scripts/e2e-full-run.mjs",
    "uat:phase6:playwright": "node scripts/uat-phase6-playwright.mjs",
    "uat:phase7:playwright": "node scripts/uat-phase7-playwright.mjs",
    "uat:phase8:playwright": "node scripts/uat-phase8-playwright.mjs",
    "uat:phase10:playwright": "node scripts/uat-phase10-playwright.mjs",
    "uat:phase11:playwright": "node scripts/uat-phase11-playwright.mjs",
    "uat:phase7:reset-snap": "node scripts/uat-phase7-reset-snap.mjs",
    "uat:vignette:playwright": "node scripts/uat-vignette-up-move.mjs",
    "verify": "pnpm turbo build && pnpm turbo test && pnpm verify:cloud",
    "agent:verify": "node scripts/agent-verify.mjs --fail",
    "agent:verify:plan": "node scripts/agent-verify.mjs --plan",
    "agent:verify:e2e": "node scripts/agent-verify.mjs --fail --e2e",
    "agent:verify:e2e-baseline": "node scripts/agent-verify.mjs --fail --e2e-baseline",
    "agent:verify:scope": "node scripts/agent-verify.mjs --scope-check --fail",
    "agent:verify:test": "node --test scripts/agent-verify-map.test.mjs",
    "lint": "eslint scripts/lib scripts/agent-verify.mjs",
    "hooks:install": "bash scripts/install-git-hooks.sh",
    "gsd:review:probe": "node scripts/gsd-review-providers.mjs --probe",
    "gsd:review:agnes": "node scripts/gsd-review-providers.mjs --provider agnes",
    "gsd:review:nvidia": "node scripts/gsd-review-providers.mjs --provider nvidia",
    "gsd:review:providers": "node scripts/gsd-review-providers.mjs --provider all"
  },
  "devDependencies": {
    "@colyseus/sdk": "0.17.8",
    "@eslint/js": "^9.39.1",
    "concurrently": "^9.1.2",
    "eslint": "^9.39.1",
    "pngjs": "^7.0.0",
    "postgres": "^3.4.7",
    "redis": "^4.7.0",
    "turbo": "^2.3.0",
    "typescript": "^5.7.2"
  }
}
