{
  "name": "aetherlife",
  "private": true,
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "turbo run build",
    "test": "turbo run test --continue",
    "dev": "turbo run dev --filter=@aetherlife/web --filter=@aetherlife/game-server",
    "dev:stack": "concurrently -k -n web+gs,ai,worker -c cyan,magenta,yellow \"pnpm dev\" \"pnpm dev:ai\" \"pnpm dev:worker\"",
    "dev:stack:mock": "concurrently -k -n web+gs,ai,worker -c cyan,magenta,yellow \"pnpm dev\" \"pnpm dev:ai\" \"LLM_MOCK=1 pnpm dev:worker\"",
    "dev:ai": "cd apps/ai-gateway && uv run uvicorn app.main:app --reload --port 8000",
    "dev:worker": "cd workers/agent-worker && uv run python -m src.main",
    "docker:ai": "docker compose -f infra/docker-compose.yml up -d ai-gateway",
    "verify:cloud": "node scripts/verify-cloud.mjs",
    "verify:llm-models": "node scripts/verify-llm-models.mjs",
    "verify:phase2": "node scripts/verify-phase2.mjs",
    "verify:phase3": "node scripts/verify-phase3.mjs",
    "verify:phase4": "node scripts/verify-phase4.mjs",
    "verify:phase5": "node scripts/verify-phase5.mjs",
    "verify:phase6": "node scripts/verify-phase6.mjs",
    "verify:phase6:move-only": "SKIP_SPEAK_VERIFY=1 node scripts/verify-phase6.mjs",
    "verify:phase7": "node scripts/verify-phase7.mjs",
    "verify:phase8": "node scripts/verify-phase8.mjs",
    "verify:phase8:move-only": "SKIP_SPEAK_VERIFY=1 node scripts/verify-phase8.mjs",
    "verify:phase8:soak": "SOAK=1 node scripts/verify-phase8.mjs",
    "verify:phase10": "node scripts/verify-phase10.mjs",
    "verify:phase10:move-only": "node scripts/verify-phase10.mjs",
    "verify:phase11": "node scripts/verify-phase11.mjs",
    "uat:phase6:playwright": "node scripts/uat-phase6-playwright.mjs",
    "uat:phase7:playwright": "node scripts/uat-phase7-playwright.mjs",
    "uat:phase8:playwright": "node scripts/uat-phase8-playwright.mjs",
    "uat:phase10:playwright": "node scripts/uat-phase10-playwright.mjs",
    "uat:phase11:playwright": "node scripts/uat-phase11-playwright.mjs",
    "uat:phase7:reset-snap": "node scripts/uat-phase7-reset-snap.mjs",
    "uat:vignette:playwright": "node scripts/uat-vignette-up-move.mjs",
    "verify": "pnpm turbo build && pnpm turbo test && pnpm verify:cloud"
  },
  "devDependencies": {
    "@colyseus/sdk": "0.17.8",
    "concurrently": "^9.1.2",
    "postgres": "^3.4.7",
    "redis": "^4.7.0",
    "turbo": "^2.3.0",
    "typescript": "^5.7.2"
  }
}
