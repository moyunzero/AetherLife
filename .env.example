# Supabase — Settings → Database → Connection string
# Dev stack: Transaction pooler port **6543** (not 5432 session cap 15).
# With 6543, clients must disable prepared statements (postgres.js prepare:false, psycopg prepare_threshold=None).
DATABASE_URL=postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?sslmode=require

# Upstash — Redis database → Connect → Redis URL (TLS)
REDIS_URL=rediss://default:[password]@[endpoint].upstash.io:6379

GAME_SERVER_PORT=2567
# Phase 10 chunk terrain — deterministic biome noise (same seed = same world)
WORLD_SEED=42
AI_GATEWAY_PORT=8000
WEB_PORT=5173

# LLM — Phase 2+: OpenRouter / Groq / Agnes / Zhipu (OpenAI-compatible)
# Phase 11.6: NPC 主路径推荐智谱 glm-4.7-flash
LLM_PROVIDER=zhipu
LLM_MODEL=glm-4.7-flash
LLM_MODEL_NPC=glm-4.7-flash
# 留空 = 仅 LLM_MODEL；OpenRouter 兜底主模型见 LLM_MODEL_OPENROUTER_FALLBACK；额外 OR 模型列表：
LLM_MODEL_FALLBACKS=
LLM_MODEL_OPENROUTER_FALLBACK=openrouter/free
LLM_PROVIDER_FALLBACK=openrouter
# 可选第三槽：质量兜底（Cerebras 5 RPM，勿作高频路径）
# LLM_PROVIDER_FALLBACK_2=cerebras
LLM_PROVIDER_REFLECT=agnes
LLM_MODEL_REFLECT=agnes-2.0-flash
# Importance JSON — NVIDIA nano（快、短文本）；勿占智谱 NPC 槽
LLM_PROVIDER_IMPORTANCE=nvidia
LLM_MODEL_IMPORTANCE=nvidia/llama-3.1-nemotron-nano-8b-v1
# 高频 speak 辅助 — SiliconFlow Qwen（L0 1000 RPM）；失败 → Agnes
LLM_PROVIDER_SOCIAL=siliconflow
LLM_MODEL_SOCIAL=Qwen/Qwen3.5-4B
LLM_PROVIDER_SOCIAL_FALLBACK=agnes
LLM_PROVIDER_AUXILIARY_FALLBACK=agnes
LLM_PROVIDER_SUMMARIZE=siliconflow
LLM_MODEL_SUMMARIZE=Qwen/Qwen3.5-4B
LLM_PROVIDER_COLLECTIVE_REFINE=siliconflow
LLM_MODEL_COLLECTIVE_REFINE=Qwen/Qwen3.5-4B
OPENROUTER_API_KEY=
# Secondary OpenRouter key — auto-failover on 429 (also OPENROUTER_API_KEYS=key1,key2)
OPENROUTER_API_KEY_2=
GROQ_API_KEY=
AGNES_API_KEY=
ZHIPU_API_KEY=

# Cerebras Cloud — gpt-oss-120b 大模型槽位（OpenAI-compatible）
# 平台: https://cloud.cerebras.ai — 默认 Production 配额: 5 req/min, 30k tok/min, 65k context
# 勿作 NPC 主路径（RPM 低）；可选 LLM_PROVIDER_FALLBACK_2 / LLM_PROVIDER_LORE_FALLBACK_2
CEREBRAS_API_KEY=
LLM_MODEL_CEREBRAS=gpt-oss-120b
CEREBRAS_MAX_COMPLETION_TOKENS=4096
# 可选覆盖平台配额（worker 进程内滑动窗口限速）
# CEREBRAS_REQUESTS_PER_MINUTE=5
# CEREBRAS_REQUESTS_PER_HOUR=150
# CEREBRAS_REQUESTS_PER_DAY=2400
# CEREBRAS_TOKENS_PER_MINUTE=30000
# CEREBRAS_TOKENS_PER_HOUR=1000000
# CEREBRAS_TOKENS_PER_DAY=1000000

# SiliconFlow — OpenAI-compatible; L0 按模型独立 RPM/TPM
# 平台: https://api.siliconflow.cn/v1 — Qwen 须 enable_thinking:false (factory 已接入)
SILICONFLOW_API_KEY=
LLM_MODEL_SILICONFLOW_FAST=Qwen/Qwen3.5-4B
LLM_MODEL_SILICONFLOW_REASON=deepseek-ai/DeepSeek-R1-0528-Qwen3-8B

# NVIDIA NIM — build.nvidia.com 免费推理目录 (factory 已接入)
# Base: https://integrate.api.nvidia.com/v1
NVIDIA_API_KEY=
LLM_MODEL_NVIDIA_FAST=qwen/qwen3-next-80b-a3b-instruct
LLM_MODEL_NVIDIA_LARGE=openai/gpt-oss-120b
LLM_MODEL_NVIDIA_NANO=nvidia/llama-3.1-nemotron-nano-8b-v1
LLM_MODEL_NVIDIA_LORE=nvidia/llama-3.3-nemotron-super-49b-v1.5

LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=aetherlife-dev

# CI / offline tests
LLM_MOCK=0

# Phase 3 — free embeddings only (see docs/phase3-embed-spike.md)
EMBED_MODEL=nvidia/llama-nemotron-embed-vl-1b-v2:free
EMBED_BASE_URL=https://openrouter.ai/api/v1
REFLECT_EVERY_N=5
SUMMARIZE_THRESHOLD=100
SUMMARIZE_BATCH_SIZE=50

# Phase 11 — chunk lore LLM (T0/T1 tiering)
LLM_PROVIDER_LORE=agnes
LLM_MODEL_LORE_T1=agnes-2.0-flash
LLM_MODEL_LORE_T0=agnes-2.0-flash
# Fallback when primary lore provider hits 429/quota/auth/network (nvidia|groq|agnes|openrouter|…)
LLM_PROVIDER_LORE_FALLBACK=nvidia
LLM_MODEL_LORE_FALLBACK=nvidia/llama-3.3-nemotron-super-49b-v1.5
# 可选第二 Lore 兜底（低 RPM 大模型，如 Cerebras gpt-oss-120b）
# LLM_PROVIDER_LORE_FALLBACK_2=cerebras

# Worker → game-server internal callbacks (optional)
INTERNAL_WORKER_TOKEN=
GAME_SERVER_URL=http://127.0.0.1:2567
AI_GATEWAY_URL=http://127.0.0.1:8000
