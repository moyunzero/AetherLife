# Supabase — Settings → Database → Connection string → Session pooler (URI)
DATABASE_URL=postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?sslmode=require

# Upstash — Redis database → Connect → Redis URL (TLS)
REDIS_URL=rediss://default:[password]@[endpoint].upstash.io:6379

GAME_SERVER_PORT=2567
# Phase 10 chunk terrain — deterministic biome noise (same seed = same world)
WORLD_SEED=42
AI_GATEWAY_PORT=8000
WEB_PORT=5173

# LLM — Phase 2+: OpenRouter / Groq / Agnes / Zhipu (OpenAI-compatible)
# Phase 11.6: NPC 主路径推荐智谱 glm-4.7-flash
LLM_PROVIDER=zhipu
LLM_MODEL=glm-4.7-flash
LLM_MODEL_NPC=glm-4.7-flash
# 留空 = 仅 LLM_MODEL；跨 provider 兜底用 LLM_PROVIDER_FALLBACK + LLM_MODEL_FALLBACKS
LLM_MODEL_FALLBACKS=
# LLM_PROVIDER_FALLBACK=openrouter
LLM_PROVIDER_REFLECT=agnes
LLM_MODEL_REFLECT=agnes-2.0-flash
OPENROUTER_API_KEY=
# Secondary OpenRouter key — auto-failover on 429 (also OPENROUTER_API_KEYS=key1,key2)
OPENROUTER_API_KEY_2=
GROQ_API_KEY=
AGNES_API_KEY=
ZHIPU_API_KEY=

# LangSmith (INFR-03)
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=aetherlife-dev

# CI / offline tests
LLM_MOCK=0

# Phase 3 — free embeddings only (see docs/phase3-embed-spike.md)
EMBED_MODEL=nvidia/llama-nemotron-embed-vl-1b-v2:free
EMBED_BASE_URL=https://openrouter.ai/api/v1
REFLECT_EVERY_N=5
SUMMARIZE_THRESHOLD=100
SUMMARIZE_BATCH_SIZE=50

# Phase 11 — chunk lore LLM (T0/T1 tiering)
LLM_PROVIDER_LORE=agnes
LLM_MODEL_LORE_T1=agnes-2.0-flash
LLM_MODEL_LORE_T0=agnes-2.0-flash
# Fallback when primary lore provider hits 429/quota/auth/network (groq|agnes|openrouter|zhipu)
LLM_PROVIDER_LORE_FALLBACK=zhipu
LLM_MODEL_LORE_FALLBACK=glm-4.7-flash

# Worker → game-server internal callbacks (optional)
INTERNAL_WORKER_TOKEN=
GAME_SERVER_URL=http://127.0.0.1:2567
AI_GATEWAY_URL=http://127.0.0.1:8000
