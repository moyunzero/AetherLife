# Supabase — Settings → Database → Connection string → Session pooler (URI)
DATABASE_URL=postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?sslmode=require

# Upstash — Redis database → Connect → Redis URL (TLS)
REDIS_URL=rediss://default:[password]@[endpoint].upstash.io:6379

GAME_SERVER_PORT=2567
AI_GATEWAY_PORT=8000
WEB_PORT=5173

# LLM — Phase 2: OpenRouter / Groq / Agnes (free tier only; OpenAI-compatible)
LLM_PROVIDER=openrouter
LLM_MODEL=meta-llama/llama-3.3-70b-instruct:free
LLM_PROVIDER_REFLECT=agnes
LLM_MODEL_REFLECT=agnes-2.0-flash
OPENROUTER_API_KEY=
GROQ_API_KEY=
AGNES_API_KEY=

# LangSmith (INFR-03)
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=aetherlife-dev

# CI / offline tests
LLM_MOCK=0
